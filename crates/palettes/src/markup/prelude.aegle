// Palettes prelude: `use "palettes.aegle"` in a panel document.
//
// Declare any of these states in your document and Palettes keeps them current;
// leave them out and the service behind them never starts.
//
//   state output: string               the output this panel is on, such as "DP-1"
//   state time: string                 local time, formatted by `time_format`
//   state time_format: string          strftime pattern, "%H:%M" if empty
//   state date: string                 local date, formatted by `date_format`
//   state date_format: string          strftime pattern, "%a %d %b" if empty
//   state workspaces: list<Workspace>  every workspace, by output (Pastel IPC or ext-workspace-v1)
//   state output_workspaces: list<Workspace>   this panel's output's workspaces
//   state windows: list<Toplevel>       every window, by workspace
//   state focused_title: string        the focused window's title
//   state focused_app: string          its app id
//   state focused_icon: string         its icon file
//   state keyboard_layout: string      the active layout's name, such as "English (US)" (Pastel)
//   state volume: float                default output volume, 1.0 = 100 %
//   state muted: bool
//   state mic_volume: float            default input volume
//   state mic_muted: bool
//   state audio_device: string         default output's description
//   state applications: list<App>      launchable applications, by name
//   state palette: list<string>        "#rrggbb" colors of the latest `Image { palette: true }`;
//                                      also tokens `palette.1` to `palette.5`
//   state battery: Battery              UPower's battery; percent 1.0 = 100 %
//   state power_profile: string         "power-saver", "balanced" or "performance"
//   state power_profiles: list<string>  the profiles to choose from
//   state media: Player                 the player that last started playing (MPRIS)
//   state players: list<Player>         every player
//   state media_position: float         its position in seconds, each second while playing
//   state notifications: list<Notification>        newest first; Palettes is the server
//   state notification_popups: list<Notification>  those shown as popups: new, 5 s unless critical
//   state notification_actions: list<NotificationAction>  their buttons, by notification id
//   state tray: list<TrayItem>          status notifier items
//   state tray_menu: list<MenuEntry>    the menu host.tray_menu opened, submenus flattened
//   state network: Network              NetworkManager's primary connection and Wi-Fi
//   state wifi_networks: list<WifiNetwork>  in range, the active one first, then by strength
//   state bluetooth: Bluetooth          BlueZ's first adapter
//   state bluetooth_devices: list<BluetoothDevice>  named or paired; connected first
//   state brightness: float             the backlight, 1.0 = full
//   state backlight: bool               whether there is one
//   state cpu: float                    processor use, 1.0 = 100 %, every 2 s
//   state memory: Memory                memory use, every 2 s
//
// Host actions, for `on` blocks:
//
//   host.spawn(string)             run a command line
//   host.launch(string)            start an application by desktop id
//   host.focus_workspace(int)      show a workspace (Workspace.id)
//   host.focus_window(int)         focus a window (Window.id)
//   host.close_window(int)
//   host.compositor(string)        a compositor action, such as "focus-workspace-down"
//   host.set_volume(float)         0.0–1.5
//   host.toggle_mute()
//   host.set_mic_volume(float)
//   host.toggle_mic_mute()
//   host.set_power_profile(string)
//   host.media_play_pause()  host.media_next()  host.media_previous()
//   host.media_seek(float)         seconds
//   host.dismiss_notification(int)  host.dismiss_notifications()
//   host.notification_action(int, string)   id and key; "default" is a click on it
//   host.tray_activate(string)  host.tray_secondary(string)  host.tray_scroll(string, int)
//   host.tray_menu(string)         read an item's menu into tray_menu
//   host.tray_select(int)          choose a tray_menu entry
//   host.toggle_wifi()  host.wifi_scan()  host.wifi_disconnect()
//   host.wifi_connect(string, string)    ssid and password ("" for a saved or open network)
//   host.toggle_bluetooth()  host.bluetooth_scan(bool)
//   host.bluetooth_connect(string)  host.bluetooth_disconnect(string)   by address
//   host.bluetooth_pair(string)  host.bluetooth_forget(string)
//   host.set_brightness(float)     0.0–1.0, through logind
//   host.toggle(string)            open or close another panel document
//   host.open(string)              open a document unless it is open
//   host.close(string)             close a document if it is open
//   host.reload()                  reload every document
//   host.quit()
//
// A Luau script beside the document (`bar.luau` for `bar.aegle`) runs while it
// is open: `state.name = value` fills states, its top-level functions are host
// actions. `Panel { edge: popup }` opens beside the control under the pointer.

record Workspace { id: int; name: string; index: int; output: string; active: bool; focused: bool; windows: int }
record Toplevel { id: int; title: string; app_id: string; icon: string; workspace: int; focused: bool }
record App { id: string; name: string; icon: string }
record Battery { present: bool; percent: float; state: string; charging: bool; time: int; icon: string; on_battery: bool }
record Player { name: string; identity: string; icon: string; status: string; playing: bool; title: string; artist: string; album: string; art: string; length: float; can_next: bool; can_previous: bool; can_play: bool; can_seek: bool }
record Notification { id: int; app: string; icon: string; summary: string; body: string; urgency: int; popup: bool; actions: int }
record NotificationAction { id: int; key: string; label: string }
record TrayItem { id: string; title: string; icon: string; status: string; tooltip: string; menu: bool }
record MenuEntry { id: int; label: string; icon: string; enabled: bool; toggle: string; checked: bool; separator: bool; depth: int; submenu: bool }
record Network { kind: string; name: string; connected: bool; strength: int; wifi: bool; wifi_available: bool }
record WifiNetwork { ssid: string; strength: int; secure: bool; active: bool; saved: bool }
record Bluetooth { available: bool; powered: bool; scanning: bool }
record Memory { used: int; total: int; percent: float }
record BluetoothDevice { address: string; name: string; icon: string; paired: bool; connected: bool; battery: int }
